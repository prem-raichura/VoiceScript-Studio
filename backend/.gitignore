# =============================================================
#  VoiceScript Studio — Backend .gitignore
#  Stack: Node.js · Express · Groq · yt-dlp · ffmpeg
# =============================================================

# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Secrets & Environment ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Logs ──────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── yt-dlp / ffmpeg Downloads & Temp Files ────────────────────
*.mp3
*.mp4
*.webm
*.m4a
*.wav
*.ogg
*.flac
*.opus
*.part
*.ytdl
downloads/
tmp/
temp/

# ── Testing & Coverage ────────────────────────────────────────
coverage/
.nyc_output/

# ── OS & Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# ── Misc ──────────────────────────────────────────────────────
*.bak
*.tmp
