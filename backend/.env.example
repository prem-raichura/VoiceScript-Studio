# Groq API key (Whisper + translation)
GROQ_API_KEY=your_groq_key_here

# Comma-separated allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Vercel Blob read/write token.
# On Vercel: auto-injected once you link a Blob store to the project.
# Local dev: copy it from the Vercel dashboard → Storage → your Blob store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
